# Copy to .env (cp .env.example .env) and adjust. .env is gitignored; this file is committed.

# Used by `npm run dev`, `npm run migrate` and `npm start`.
DATABASE_URL=postgresql://recon:recon_dev@localhost:5432/finance_recon

# Used only by the tests. Use a dedicated database: the tests DROP and TRUNCATE its tables.
# Never point this at a database whose data you want to keep. See 'Database setup' in the README.
TEST_DATABASE_URL=postgresql://recon:recon_dev@localhost:5432/finance_recon_test
