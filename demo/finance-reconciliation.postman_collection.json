          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders",
            "description": ""
          }
        },
        {
          "name": "09 Show open exceptions — capture missing exception ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const orderRef = pm.collectionVariables.get(\"runId\") + \"-missing\";",
                  "const exception = pm.response.json().data.find(row => row.order_ref === orderRef);",
                  "pm.test(\"Missing-settlement exception exists\", function () { pm.expect(exception).to.exist; });",
                  "if (exception) pm.collectionVariables.set(\"missingExceptionId\", String(exception.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/exceptions?status=OPEN",
            "description": ""
          }
        },
        {
          "name": "10 Show summary",
          "event": [
            {
              "listen": "test",
