{
  "info": {
    "name": "Finance Reconciliation — API Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run request 01 first to create a unique rehearsal prefix. Send requests individually while explaining them. Summary totals include all records in the connected database. This demo creates data and reconciliation processes every order. Use a development instance."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "run-request-01-first",
      "type": "string"
    },
    {
      "key": "missingExceptionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Main demo — send in numbered order",
      "item": [
        {
          "name": "01 Health — start a fresh rehearsal",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", \"demo-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"missingExceptionId\", \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": ""
          }
        },
        {
          "name": "02 Create matched order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderRef\": \"{{runId}}-matched\",\n  \"customerName\": \"Demo Customer\",\n  \"expectedAmountPaisa\": 10000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/orders",
            "description": ""
          }
        },
        {
          "name": "03 Create short order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
