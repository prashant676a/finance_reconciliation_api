                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderRef\": \"{{runId}}-short\",\n  \"customerName\": \"Demo Customer\",\n  \"expectedAmountPaisa\": 10000\n}",
              "options": {
