        },
        {
          "name": "16 Manually resolve missing exception",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNote\": \"Reviewed: remaining difference accepted for this demo\",\n  \"resolvedBy\": \"Demo Reviewer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/exceptions/{{missingExceptionId}}/resolve",
            "description": "This records a review decision. It does not change the settlement amount or make the order MATCHED."
          }
        },
        {
          "name": "17 Show final summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
